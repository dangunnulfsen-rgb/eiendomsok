{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/build",
  "rewrites": [
    { "source": "/api/companies", "destination": "/api/companies.js" },
    { "source": "/api/properties", "destination": "/api/properties.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
